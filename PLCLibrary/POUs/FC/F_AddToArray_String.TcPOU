<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_AddToArray_String" Id="{6036b30f-f9b5-45a6-b9ba-960a4a5eb838}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_AddToArray_String : BOOL
VAR_INPUT
    value : STRING;            // String to add
    maxSize : DINT;           // Maximum array capacity
END_VAR
VAR_IN_OUT
    arr : ARRAY[*] OF STRING; // Array of strings
END_VAR
VAR
    currentSize : DINT := 0;
    i : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_AddToArray_String := FALSE;

// Find current size by looking for first empty string
FOR i := 1 TO UPPER_BOUND(arr, 1) DO
    IF arr[i] = '' THEN
        currentSize := i;
        EXIT;
    END_IF
    // If we reach the end without finding empty string
    IF i = UPPER_BOUND(arr, 1) THEN
        currentSize := i + 1;
    END_IF
END_FOR

// Check if there's space to add
IF currentSize >= maxSize OR currentSize > UPPER_BOUND(arr, 1) THEN
    RETURN;
END_IF

// Add the string
arr[currentSize] := value;
F_AddToArray_String := TRUE;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>