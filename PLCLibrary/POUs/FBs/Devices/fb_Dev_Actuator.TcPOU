    <Method Name="cmdActuate" Id="{0e9fda91-8d5f-4566-a5c5-acf49981b4f4}">
      <Declaration><![CDATA[METHOD PUBLIC cmdActuate : BOOL
VAR_INPUT
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Interlock.outInterlockOK AND NOT stsFaulted THEN
	_setActuate :=TRUE;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="cmdReset" Id="{11ab5455-1962-4f91-aeda-b84e24d3ac25}">
      <Declaration><![CDATA[METHOD cmdReset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stsFaulted THEN
	setFault(0,'');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="cmdRetract" Id="{a721761f-2f78-4f45-88de-6492373238ef}">
      <Declaration><![CDATA[METHOD PUBLIC cmdRetract : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Retracting (de-energising) is always allowed. It used to require the interlock to be met,
// so an actuator whose interlock dropped could not be switched off, by the operator or by code,
// unless cfgRetractOnFault happened to be set.
_setActuate := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FaultHandler" Id="{a88fc260-ac03-4357-9f5c-cfcc4dfecdaf}" FolderPath="Privates\">
      <Declaration><![CDATA[METHOD PRIVATE FaultHandler : BOOL
VAR_INPUT
	inpFeedback : BOOL; 
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//if setActuate, set timer. If timer done and no feedback, then fault
IF (_onDelay_Time <> T#0S) AND _hasfeedback THEN
	_faultH_onDelay(IN:=_faultH_OnDelay_Trigger,PT:=_onDelay_time);
	IF (NOT stsFaulted) AND _setActuate THEN
		_faultH_OnDelay_Trigger := TRUE;
		IF _faultH_onDelay.Q AND NOT _actuatorFeedback THEN
			setFault(1,'actuator feedback missing.');
		END_IF
	ELSE
		_faultH_OnDelay_Trigger := FALSE;
	END_IF
END_IF

IF (_offDelay_Time <> T#0S) AND _hasfeedback THEN
	_faultH_offDelay(IN:=_faultH_OffDelay_Trigger,PT:=_offDelay_time);
	IF (NOT stsFaulted) AND NOT(_setActuate) THEN
		_faultH_OffDelay_Trigger := TRUE;
		IF _faultH_offDelay.Q AND _actuatorFeedback THEN
			setFault(1,'Feedback present when not actuated.');
		END_IF
	ELSE
		_faultH_OffDelay_Trigger := FALSE;
	END_IF
END_IF


//IF _actuatorFeedback AND NOT(_setActuate) and _hasFeedback THEN
//	setFault(1,'Feedback present when not actuated');
//END_IF

//if not actuated but feedback is in, actuator is stuck closed
//+TODO

//If enabled and cmdActuated and lost interlock, then fault
IF NOT stsFaulted AND _setActuate THEN
	IF NOT interlock.outInterlockOK THEN
		setFault(1,CONCAT('I_NOK - ',Interlock.stsFirstOut));
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{7407b03c-e4e5-4437-a988-6afe951e456e}" FolderPath="Privates\">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	
	cfgDeviceName 		: STRING;
	cfgEnable 			: BOOL;
	cfgInitEventClass	: BOOL;
	cfgOnDelay 			: TIME;
	cfgOffDelay			: TIME;
	cfgRetractOnFault 	: BOOL;
	cfgInvFeedback		: BOOL; 
	cfgHasFeedback		: BOOL;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.cfgDeviceName 		:= 		cfgDeviceName; 
THIS^.cfgEnable				:=		cfgEnable;
THIS^.cfgInitEventClass		:= 		cfgInitEventClass;		
THIS^.cfgOnDelay 			:= 		cfgOnDelay; 
THIS^.cfgOffDelay			:=		cfgOffDelay;			
THIS^.cfgRetractOnFault		:=      cfgRetractOnFault;
THIS^.cfgInvFeedback		:=		cfgInvFeedback;
THIS^.cfgHasFeedback		:=		cfgHasFeedback;

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>