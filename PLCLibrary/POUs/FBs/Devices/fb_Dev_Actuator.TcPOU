<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_Dev_Actuator" Id="{81e85ebb-2100-42fa-8869-8bedf307b98d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fb_Dev_Actuator EXTENDS abs_fb_Device
VAR_INPUT
	IO_Input_Feedback : BOOL;
END_VAR

VAR_IN_OUT
	IO_Output_Actuate : BOOL;
END_VAR

VAR
	HMI						: ST_Actuator_HMI_Interface;
	_setActuate 			: BOOL;
	_retractOnFault			: BOOL;
	_hasFeedback			: BOOL;
	_faultH_onDelay			: TON;
	_faultH_offDelay		: TON;
	_faultH_OnDelay_Trigger	: BOOL;
	_faultH_OffDelay_Trigger: BOOL;
	_onDelay_time			: TIME;
	_offDelay_time			: TIME;
	_InvFeedback			: BOOL;
	_actuatorFeedback		: BOOL;
	_maintainAutoState		: BOOL;
	_disableHMIControl		: BOOL;
END_VAR

VAR_OUTPUT
	stsActuated : BOOL;

END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[DeviceLogic();
Interlock.name := _DeviceName;
Interlock(inpConfig := _dataInterlock);

// Flip feedback if cofigured for inverted feedback
IF _InvFeedback THEN
	IF IO_Input_Feedback THEN
		_actuatorFeedback := FALSE;
	ELSE
		_actuatorFeedback :=TRUE;
	END_IF
ELSE
	IF IO_Input_Feedback THEN
		_actuatorFeedback :=TRUE;
	ELSE
		_actuatorFeedback :=FALSE;
	END_IF
END_IF

// If no IO based feedback, set actuation state for feedback
IF _hasFeedback THEN
	stsActuated := _actuatorFeedback;
ELSE
	stsActuated := _setActuate;
END_IF

// Check for timeouts
FaultHandler(_actuatorFeedback);

// Control via HMI if in manual
// cmdActuate an cmdRetract methods only work in Auto, unless
// device is configured for no manual control
IF NOT _disableHMIControl THEN
	IF NOT _inAuto THEN 
		IF HMI.ocmdActuate THEN
			cmdActuate();
		ELSE
			cmdRetract();
		END_IF
	ELSE
		// if property set, change the HMI actuatoion toggle state so that
		// transition from auto to manual does not change the state
		// otherwise upon transition HMI will change state to whatever it was in manual last
		IF _maintainAutoState THEN
			HMI.ocmdActuate := _setActuate;
		END_IF
	END_IF
END_IF
// Configure retract on feedback
IF stsFaulted AND _retractOnFault THEN
	HMI.ocmdActuate := 0;
	_setActuate		:= 0;
END_IF

// Log state changes
IF _setActuate THEN
	IO_output_actuate :=TRUE;
	sendLog('Actuating ON',1);
ELSE
	IO_output_actuate :=FALSE;
	sendLog('Actuating OFF',1);
END_IF

HMI.HMIbaseDevice := HMIbaseDevice;
HMI.stsActuated   := stsActuated;
HMI.setActuate    := _setActuate;




]]></ST>
    </Implementation>
    <Folder Name="Privates" Id="{98a5be4d-699f-42e4-a6a5-0814ff6a062c}" />
