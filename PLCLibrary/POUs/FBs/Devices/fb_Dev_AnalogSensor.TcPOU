    <Method Name="cmdReset" Id="{78448479-001d-465c-889f-2ecec2bbc229}">
      <Declaration><![CDATA[METHOD cmdReset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setFault(0, '');]]></ST>
      </Implementation>
    </Method>
    <Method Name="FaultHandler" Id="{6cb13eed-dfb7-459f-9aa0-bcdcdc13a0de}">
      <Declaration><![CDATA[METHOD PROTECTED FaultHandler : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _alarmEnable THEN
	//L Warning
	_alarmDebounce[1](IN:=_alarmCooldown[1], PT:=T#30S);
	_alarmDebounce[2](IN:=_alarmCooldown[2], PT:=T#30S);
	IF _engValue < cfgAlarmL THEN
		IF NOT _alarmCooldown[1] THEN
			sendWarning(CONCAT(CONCAT('Low Warning - ', ANY_TO_STRING(TO_REAL(_engValue))),_EngUnit),1);
			_alarmCooldown[1] := TRUE;
		END_IF
	END_IF
	IF _alarmCooldown[1] AND _alarmDebounce[1].Q THEN
		_alarmCooldown[1] := FALSE;
	END_IF
	
	//H Warning
	IF _engValue > cfgAlarmH THEN
		IF NOT _alarmCooldown[2] THEN
			sendWarning(CONCAT(CONCAT('High Warning - ', ANY_TO_STRING(TO_REAL(_engValue))),_EngUnit),2);
			_alarmCooldown[2] := TRUE;
		END_IF
	END_IF
	IF _alarmCooldown[2] AND _alarmDebounce[2].Q THEN
		_alarmCooldown[2] := FALSE;
	END_IF
	
	IF _engValue < cfgAlarmLL THEN
		setFault(1,CONCAT(CONCAT('Low Alarm - ', ANY_TO_STRING(TO_REAL(_engValue))),_EngUnit));
	END_IF
	
	IF _engValue > cfgAlarmHH THEN
		setFault(1,CONCAT(CONCAT('High Alarm - ', ANY_TO_STRING(TO_REAL(_engValue))),_EngUnit));
	END_IF
	
	IF inpChannelDiag.error THEN
		setFault(1, 'Channel Error');
	END_IF
	
	IF inpChannelDiag.overrange THEN
		setFault(1, 'Overrange');
	END_IF
	
	IF inpChannelDiag.underrange THEN
		setFault(1, 'Underrange');
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{4ac9531d-1d47-4246-9b5f-b8f7308c70c4}">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains	: BOOL;
	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode			: BOOL;
	cfgDeviceName		: STRING;
	cfgEnable			: BOOL;
	cfgInitEventClass	: BOOL;
	cfgAlarmEnable		: BOOL;
	cfgAlarmH			: LREAL;
	cfgAlarmHH			: LREAL;
	cfgAlarmL			: LREAL;
	cfgAlarmLL			: LREAL;
	cfgEngUnit			: STRING;
	cfgCalOffset		: LREAL;
	cfgCalGain			: LREAL := 1.0;	// omitted in the declaration = 1 (no correction)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.cfgDeviceName 		:= 		cfgDeviceName; 		
THIS^.cfgEnable 			:= 	    cfgEnable; 	
THIS^.cfgInitEventClass		:= 		cfgInitEventClass;
THIS^.cfgAlarmEnable		:=		cfgAlarmEnable;
THIS^.cfgAlarmH				:=		cfgAlarmH;
THIS^.cfgAlarmHH			:=		cfgAlarmHH;
THIS^.cfgAlarmL				:=		cfgAlarmL;
THIS^.cfgAlarmLL			:=		cfgAlarmLL;
THIS^.cfgCalOffset			:=		cfgCalOffset;
THIS^.cfgCalGain			:=		cfgCalGain;
THIS^.cfgEngUnit			:=		cfgEngUnit;

THIS^.HMI.cfgAlarmEnable	:= cfgAlarmEnable;
THIS^.HMI.cfgAlarmH			:= cfgAlarmH;
THIS^.HMI.cfgAlarmHH		:= cfgAlarmHH;
THIS^.HMI.cfgAlarmL			:= cfgAlarmL;
THIS^.HMI.cfgAlarmLL		:= cfgAlarmLL;
THIS^.HMI.cfgEngUnit		:= cfgEngUnit;
THIS^.HMI.cfgCalOffset		:= cfgCalOffset;
THIS^.HMI.cfgCalGain		:= cfgCalGain;


]]></ST>
      </Implementation>
    </Method>
    <Method Name="scaleInput" Id="{4ed8c567-e060-4c8d-8018-b01267e3113b}">
      <Declaration><![CDATA[METHOD scaleInput : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cfgScalingNeeded THEN
	_sensorRawSignal	:= F_AnalogToEngUnit(inpRawIOChannel, cfgChannelMinInt, cfgChannelMaxInt, cfgSensorMin, cfgSensorMax);
	_engValue			:= (F_AnalogToEngUnit(stsSensorRawSignal, cfgSensorMin, cfgSensorMax, cfgEngUnitMin, cfgEngUnitMax) * _CalGain) + _CalOffset;
ELSE
	_sensorRawSignal := inpScaledIOChannel;
	_engValue		 := (inpScaledIOChannel * _CalGain) + _CalOffset;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="setHMI" Id="{7aae993c-2f01-4e4c-b6f2-f3f4d86398aa}">
      <Declaration><![CDATA[METHOD PROTECTED setHMI : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[HMI.HMIbaseDevice := HMIbaseDevice;

HMI.stsEngValue 		:= _engValue;
HMI.stsSensorRawSignal	:= _sensorRawSignal;

cfgAlarmEnable		:= HMI.cfgAlarmEnable;
cfgAlarmH			:= HMI.cfgAlarmH;
cfgAlarmHH			:= HMI.cfgAlarmHH;
cfgAlarmL			:= HMI.cfgAlarmL;
cfgAlarmLL			:= HMI.cfgAlarmLL;
cfgCalOffset		:= HMI.cfgCalOffset;
cfgCalGain			:= HMI.cfgCalGain;
cfgEngUnit			:= HMI.cfgEngUnit;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>