<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_Dev_AnalogSensor" Id="{47f6c7bd-fe02-440f-b580-1050f940601c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fb_Dev_AnalogSensor EXTENDS abs_fb_Device
VAR_INPUT
	inpRawIOChannel			: DINT;
	inpScaledIOChannel		: LREAL;
	inpChannelDiag			: ST_AnalogSensor_Diag; //IO channel diagnostics
	cfgScalingNeeded		: BOOL;					// Set to False if scaled in IO
	cfgChannelMinInt		: DINT;					//Min INT IO channel value
	cfgChannelMaxInt		: DINT;					//Max INT IO channel value
	cfgSensorMin			: LREAL;  				//Min Sensor value (0V, 4mA etc)
	cfgSensorMax			: LREAL;  				//Max Sensor value (10V, 20mA etc)
	cfgEngUnitMin			: LREAL;  				//Min span of instrument
	cfgEngUnitMax			: LREAL;  				//Max span of instrument

END_VAR
VAR_OUTPUT
	stsSensorRawSignal		: LREAL;
	stsEngValue				: LREAL;
END_VAR
VAR
	_sensorRawSignal		: LREAL;
	_engValue				: LREAL;
	_alarmEnable	: BOOL;
	_alarmL			: LREAL;
	_alarmLL		: LREAL;
	_alarmH			: LREAL;
	_alarmHH		: LREAL;
	_calOffset		: LREAL;
	_calGain		: LREAL := 1.0;	// 1 = no gain correction (0 would zero every reading)
	_engUnit		: STRING;
	_alarmDebounce  : ARRAY[1..4] OF TON;
	_alarmCooldown	: ARRAY[1..4] OF BOOL;
END_VAR

VAR PERSISTENT
	HMI	: ST_AnalogSensor_HMI_Interface;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[DeviceLogic();

scaleInput();

FaultHandler();

setHMI();

stsSensorRawSignal	:= _sensorRawSignal;
stsEngValue			:= _engValue;
]]></ST>
    </Implementation>
