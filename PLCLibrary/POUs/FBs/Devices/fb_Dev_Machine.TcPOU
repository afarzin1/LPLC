<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_Dev_Machine" Id="{a2ea1094-4c0c-42eb-a181-982990f6ea56}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fb_Dev_Machine EXTENDS abs_fb_Device

VAR_INPUT
	start				: BOOL;
	stop				: BOOL;
	SafetyPowerOn		: BOOL;
	SafetyFaultActive	: BOOL;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[DeviceLogic();
Interlock.name := _DeviceName;
Interlock(inpConfig := _dataInterlock);


faultHandler();]]></ST>
    </Implementation>
    <Method Name="cmdReset" Id="{d79f43fa-fce3-4305-b8f2-4bfcc854525f}">
      <Declaration><![CDATA[METHOD cmdReset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stsFaulted THEN
	setFault(0,'');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="faultHandler" Id="{d09ada46-c23e-4582-9e8a-0222cc86541f}">
      <Declaration><![CDATA[METHOD faultHandler : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stop THEN
	sendWarning('Machine STOP pressed',1);
END_IF

IF inpReset THEN
	sendLog('Machine RESET', 1);
ELSE
	_logChannels[1] := '';
END_IF

IF start THEN
	sendLog('Auto sequence started', 2);
ELSE
	_logChannels[2] := '';
END_IF

IF _inAuto THEN
	sendLog('Machine set to AUTO',3);
ELSE
	sendLog('Machine set to MANUAL',3);
END_IF

IF safetyPowerOn THEN
	sendLog('Safety - Power ON', 4);
ELSE
	sendLog('Safety - Power OFF', 4);
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>