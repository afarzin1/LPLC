      </Set>
    </Property>
    <Method Name="processReadBlock" Id="{3f5dc17a-3729-4f07-a982-2079411155a9}">
      <Declaration><![CDATA[METHOD PRIVATE processReadBlock
VAR_INPUT
    inpBlockIdx : UINT;
END_VAR
VAR
    _block      : REFERENCE TO ST_ReadBlock;
    _i          : UINT;
    _sigIdx     : UINT;
    _offset     : UINT;
    _parsed     : REFERENCE TO ST_ParsedSignal;
    _pResult    : POINTER TO ST_MBReadResult;
    _rawWord    : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_block REF= _arrReadBlocks[inpBlockIdx];

FOR _i := 1 TO _block.signalCount DO
    _sigIdx := _block.arrSignalIndex[_i];
    _offset := _block.arrOffsetInBlock[_i];
    _parsed REF= _arrParsedRead[_sigIdx];

    _pResult := inpPtrReadResults + UINT_TO_DWORD(_sigIdx - 1) * SIZEOF(ST_MBReadResult);

    CASE _parsed.dataType OF
        E_MBDataType.mbReal32:
            _pResult^.valueReal := wordsToReal(
                _arrRawReadBuffer[_offset],
                _arrRawReadBuffer[_offset + 1]
            );

        E_MBDataType.mbInt32:
            _pResult^.valueDint := wordsToDint(
                _arrRawReadBuffer[_offset],
                _arrRawReadBuffer[_offset + 1]
            );

        E_MBDataType.mbUInt32:
            _pResult^.valueUdint := wordsToUdint(
                _arrRawReadBuffer[_offset],
                _arrRawReadBuffer[_offset + 1]
            );

        E_MBDataType.mbInt16:
            _rawWord := swapBytes(_arrRawReadBuffer[_offset]);
            _pResult^.valueInt := WORD_TO_INT(_rawWord);

        E_MBDataType.mbUInt16:
            _rawWord := swapBytes(_arrRawReadBuffer[_offset]);
            _pResult^.valueUint := WORD_TO_UINT(_rawWord);

        E_MBDataType.mbWord16:
            _pResult^.valueWord := swapBytes(_arrRawReadBuffer[_offset]);

        E_MBDataType.mbBit:
            IF _parsed.isBitInRegister THEN
                _rawWord := swapBytes(_arrRawReadBuffer[_offset]);
                _pResult^.valueBool := (_rawWord AND SHL(WORD#1, _parsed.bitIndex)) <> 0;
            ELSE
                _pResult^.valueBool := (_arrRawReadBuffer[_offset / 16] AND SHL(WORD#1, _offset MOD 16)) <> 0;
            END_IF
    END_CASE

    _pResult^.quality := E_SignalQuality.Good;
    _pResult^.updateCount := _pResult^.updateCount + 1;
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Property Name="readSignalCount" Id="{1761a401-5c7e-4199-b2b3-502e1442bc1e}">
      <Declaration><![CDATA[PROPERTY PUBLIC readSignalCount : UINT
]]></Declaration>
      <Get Name="Get" Id="{931053b6-a877-48f4-b540-34989e64526d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[readSignalCount := cfgReadSignalCount;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{86c33099-c10c-4fd5-b191-c3974bda2db6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _initialized THEN
    cfgReadSignalCount := MIN(readSignalCount, MAX_READ_SIGNALS);
END_IF
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="readSucceeded" Id="{1fb3f461-d6b7-4fb5-90a3-b900d2de2b48}">
      <Declaration><![CDATA[METHOD PRIVATE readSucceeded : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// During an RMW read, _state = RmwReadWait and there is no current read block;
// the active FB in that case is fbMbReadRegs.
IF _state = E_DriverState.RmwReadWait THEN
    readSucceeded := NOT fbMbReadRegs.bError;
    IF fbMbReadRegs.bError THEN
        _lastMbError := 1;
    END_IF
ELSE
    CASE _arrReadBlocks[_currentBlockIdx].functionCode OF
        1:
            readSucceeded := NOT fbMbReadCoils.bError;
            IF fbMbReadCoils.bError THEN
                _lastMbError := 1;
            END_IF
        2:
            readSucceeded := NOT fbMbReadInputs.bError;
            IF fbMbReadInputs.bError THEN
                _lastMbError := 1;
            END_IF
        3:
            readSucceeded := NOT fbMbReadRegs.bError;
            IF fbMbReadRegs.bError THEN
                _lastMbError := 1;
            END_IF
        4:
            readSucceeded := NOT fbMbReadInputRegs.bError;
            IF fbMbReadInputRegs.bError THEN
                _lastMbError := 1;
            END_IF
    END_CASE
END_IF

stsStatus.lastErrorCode := _lastMbError;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="realToWords" Id="{3760e2e3-5d3a-4b6f-acbf-224871e36e42}">
      <Declaration><![CDATA[METHOD PRIVATE realToWords
VAR_INPUT
    inpValue        : REAL;
END_VAR
VAR_OUTPUT
    stsWord0        : WORD;
    stsWord1        : WORD;
END_VAR
VAR
    _dword          : DWORD;
    _w0, _w1        : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMCPY(ADR(_dword), ADR(inpValue), SIZEOF(REAL));
splitDword(inpValue := _dword, stsWord0 => _w0, stsWord1 => _w1);
stsWord0 := swapBytes(_w0);
stsWord1 := swapBytes(_w1);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="reconnectDelay" Id="{ca6af3e2-8466-4901-b835-5e5be9c77d85}">
      <Declaration><![CDATA[PROPERTY PUBLIC reconnectDelay : TIME
]]></Declaration>
      <Get Name="Get" Id="{4775b455-64c3-4ff4-ae15-6833ad948259}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[reconnectDelay := cfgReconnectDelay;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{81cdc6a4-7de5-427e-a194-b0178c13699f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _initialized THEN
    cfgReconnectDelay := reconnectDelay;
END_IF
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="reset" Id="{754d0347-0f0b-4377-8ecf-d5045b082dd8}">
      <Declaration><![CDATA[METHOD PRIVATE reset
VAR
    _i : UINT;
    _pResult : POINTER TO ST_MBReadResult;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_state := E_DriverState.Init;
_initialized := FALSE;
_socketConnected := FALSE;
_consecFailures := 0;
_connectAttempts := 0;
_disconnectPending := FALSE;

MEMSET(ADR(stsStatus), 0, SIZEOF(stsStatus));
stsError := FALSE;
stsErrorId := 0;

MEMSET(ADR(_arrParsedRead), 0, SIZEOF(_arrParsedRead));
MEMSET(ADR(_arrParsedWrite), 0, SIZEOF(_arrParsedWrite));
MEMSET(ADR(_arrReadBlocks), 0, SIZEOF(_arrReadBlocks));
MEMSET(ADR(_arrWriteBlocks), 0, SIZEOF(_arrWriteBlocks));
MEMSET(ADR(_arrBitRegisters), 0, SIZEOF(_arrBitRegisters));

_readBlockCount := 0;
_writeBlockCount := 0;
_bitRegisterCount := 0;

tonPollInterval(IN := FALSE);
tonWriteInterval(IN := FALSE);
tonCommandDelay(IN := FALSE);
tonTimeout(IN := FALSE);
tonReconnectDelay(IN := FALSE);

IF inpPtrReadResults <> 0 THEN
    FOR _i := 1 TO cfgReadSignalCount DO
        _pResult := inpPtrReadResults + UINT_TO_DWORD(_i - 1) * SIZEOF(ST_MBReadResult);
        _pResult^.quality := E_SignalQuality.UncertainInit;
    END_FOR
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="sendReadRequest" Id="{35129bce-dfd0-4f7c-87dc-907cab83d5c4}">
      <Declaration><![CDATA[METHOD PRIVATE sendReadRequest
VAR_INPUT
    inpBlockIdx : UINT;
END_VAR
VAR
    _block : REFERENCE TO ST_ReadBlock;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_block REF= _arrReadBlocks[inpBlockIdx];

CASE _block.functionCode OF
    1:  // FC01 Read Coils
        fbMbReadCoils(
            sIPAddr     := cfgIpAddress,
            nTCPPort    := cfgPort,
            nUnitID     := cfgUnitId,
            nQuantity   := _block.quantity,
            nMBAddr     := _block.startAddress,
            cbLength    := SIZEOF(_arrRawReadBuffer),
            pDestAddr   := ADR(_arrRawReadBuffer),
            bExecute    := TRUE,
            tTimeout    := cfgTimeout
        );

    2:  // FC02 Read Discrete Inputs
        fbMbReadInputs(
            sIPAddr     := cfgIpAddress,
            nTCPPort    := cfgPort,
            nUnitID     := cfgUnitId,
            nQuantity   := _block.quantity,
            nMBAddr     := _block.startAddress,
            cbLength    := SIZEOF(_arrRawReadBuffer),
            pDestAddr   := ADR(_arrRawReadBuffer),
            bExecute    := TRUE,
            tTimeout    := cfgTimeout
        );

    3:  // FC03 Read Holding Registers
        fbMbReadRegs(
            sIPAddr     := cfgIpAddress,
            nTCPPort    := cfgPort,
            nUnitID     := cfgUnitId,
            nQuantity   := _block.quantity,
            nMBAddr     := _block.startAddress,
            cbLength    := UINT_TO_UDINT(_block.quantity) * 2,
            pDestAddr   := ADR(_arrRawReadBuffer),
            bExecute    := TRUE,
            tTimeout    := cfgTimeout
        );

    4:  // FC04 Read Input Registers
        fbMbReadInputRegs(
            sIPAddr     := cfgIpAddress,
            nTCPPort    := cfgPort,
            nUnitID     := cfgUnitId,
            nQuantity   := _block.quantity,
            nMBAddr     := _block.startAddress,
            cbLength    := UINT_TO_UDINT(_block.quantity) * 2,
            pDestAddr   := ADR(_arrRawReadBuffer),
            bExecute    := TRUE,
            tTimeout    := cfgTimeout
        );
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="sendRmwReadRequest" Id="{15b463aa-d359-4775-897d-fdb9683582c9}">
      <Declaration><![CDATA[METHOD PRIVATE sendRmwReadRequest
VAR_INPUT
    inpRmwIdx : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// RMW always operates on a single holding register (FC03 read).
fbMbReadRegs(
    sIPAddr     := cfgIpAddress,
    nTCPPort    := cfgPort,
    nUnitID     := cfgUnitId,
    nQuantity   := 1,
    nMBAddr     := _arrBitRegisters[inpRmwIdx].address,
    cbLength    := 2,
    pDestAddr   := ADR(_arrRawReadBuffer),
    bExecute    := TRUE,
    tTimeout    := cfgTimeout
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="sendRmwWriteRequest" Id="{4347b936-687c-40eb-af9f-87779e770d52}">
      <Declaration><![CDATA[METHOD PRIVATE sendRmwWriteRequest
VAR_INPUT
    inpRmwIdx : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbMbWriteSingleReg(
    sIPAddr     := cfgIpAddress,
    nTCPPort    := cfgPort,
    nUnitID     := cfgUnitId,
    nMBAddr     := _arrBitRegisters[inpRmwIdx].address,
    nValue      := swapBytes(_arrBitRegisters[inpRmwIdx].writeValue),
    bExecute    := TRUE,
    tTimeout    := cfgTimeout
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="shouldSwapForSort" Id="{3f7d5974-6d6b-4455-b01a-7c8709df45b8}">
      <Declaration><![CDATA[METHOD PRIVATE shouldSwapForSort : BOOL
VAR_INPUT
    inpIdx1         : UINT;
    inpIdx2         : UINT;
    inpIsRead       : BOOL;
END_VAR
VAR
    _area1, _area2  : E_MBArea;
    _addr1, _addr2  : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF inpIsRead THEN
    _area1 := _arrParsedRead[inpIdx1].area;
    _area2 := _arrParsedRead[inpIdx2].area;
    _addr1 := _arrParsedRead[inpIdx1].baseAddress;
    _addr2 := _arrParsedRead[inpIdx2].baseAddress;
ELSE
    _area1 := _arrParsedWrite[inpIdx1].area;
    _area2 := _arrParsedWrite[inpIdx2].area;
    _addr1 := _arrParsedWrite[inpIdx1].baseAddress;
    _addr2 := _arrParsedWrite[inpIdx2].baseAddress;
END_IF

IF _area1 > _area2 THEN
    shouldSwapForSort := TRUE;
ELSIF _area1 = _area2 AND _addr1 > _addr2 THEN
    shouldSwapForSort := TRUE;
ELSE
    shouldSwapForSort := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="splitDword" Id="{99dbdecc-c50f-4a41-99b0-65a77a48ba75}">
      <Declaration><![CDATA[METHOD PRIVATE splitDword
VAR_INPUT
    inpValue        : DWORD;
END_VAR
VAR_OUTPUT
    stsWord0        : WORD;
    stsWord1        : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cfgWordOrder = E_WordOrder.BigEndian THEN
    stsWord0 := DWORD_TO_WORD(SHR(inpValue, 16));
    stsWord1 := DWORD_TO_WORD(inpValue AND 16#FFFF);
ELSE
    stsWord0 := DWORD_TO_WORD(inpValue AND 16#FFFF);
    stsWord1 := DWORD_TO_WORD(SHR(inpValue, 16));
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="staleThreshold" Id="{191e3e3a-9b55-4ea2-b165-da6cdc1d7de8}">
      <Declaration><![CDATA[PROPERTY PUBLIC staleThreshold : TIME
]]></Declaration>
      <Get Name="Get" Id="{f13b35c4-3d5f-4240-b0d0-e47cfa5afa49}">
