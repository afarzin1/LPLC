END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[timeout := cfgTimeout;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d0ad2f8b-1502-4f5a-bd7e-a7480d0d173f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _initialized THEN
    cfgTimeout := timeout;
END_IF
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="udintToWords" Id="{e2acf2bb-09fe-425d-9272-d589a2a378b3}">
      <Declaration><![CDATA[METHOD PRIVATE udintToWords
VAR_INPUT
    inpValue        : UDINT;
END_VAR
VAR_OUTPUT
    stsWord0        : WORD;
    stsWord1        : WORD;
END_VAR
VAR
    _dword          : DWORD;
    _w0, _w1        : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_dword := UDINT_TO_DWORD(inpValue);
splitDword(inpValue := _dword, stsWord0 => _w0, stsWord1 => _w1);
stsWord0 := swapBytes(_w0);
stsWord1 := swapBytes(_w1);
]]></ST>
      </Implementation>
    </Method>
