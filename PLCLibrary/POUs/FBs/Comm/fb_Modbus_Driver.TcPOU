        <ST><![CDATA[_w0 := swapBytes(inpWord0);
_w1 := swapBytes(inpWord1);
_dword := combineWords(_w0, _w1);
wordsToUdint := DWORD_TO_UDINT(_dword);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="writeCycleInterval" Id="{d0dce5f5-27ac-4ecc-a891-95501497183b}">
