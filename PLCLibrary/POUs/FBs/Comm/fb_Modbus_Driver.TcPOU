<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_Modbus_Driver" Id="{9216fba1-c86d-4127-bdbb-73384648b062}" SpecialFunc="None">
    <Declaration><![CDATA[// High-level Modbus TCP driver. Configuration-driven: define signals as
// arrays of ST_MBSignalConfig and the driver handles block optimization,
// endian conversion, RMW for bit-in-register writes, reconnection, and
// quality tracking.
//
// Usage:
//   1. Set properties (ipAddress, readSignalCount, writeSignalCount, ...)
//      BEFORE first enabling the FB.
//   2. Pass pointers to user arrays (config, results, write data) via inputs.
//   3. Call cycle() every PLC scan after the FB body call.
//   4. Optional: hold inpHoldWrites TRUE to keep reading without writing — e.g. until
//      the caller has read the device's current values to seed its write data from.
//
// Failure handling: after maxConsecFails failed transactions in a row the driver drops the
// link, waits reconnectDelay and retries; after maxReconnectAttempts such retries without a
// clean read cycle it stops in Faulted (no traffic) until cmdReset() or an enable toggle.
//
// Required library: Tc3_ModbusTCP (TF6250).
FUNCTION_BLOCK fb_Modbus_Driver
VAR_INPUT
    inpEnable               : BOOL;
    inpHoldWrites           : BOOL;     // TRUE = keep polling reads, start no write cycle

    inpPtrReadConfig        : POINTER TO ST_MBSignalConfig;
    inpPtrWriteConfig       : POINTER TO ST_MBSignalConfig;
    inpPtrReadResults       : POINTER TO ST_MBReadResult;
    inpPtrWriteData         : POINTER TO ST_MBWriteData;
END_VAR

VAR_OUTPUT
    stsStatus               : ST_MBDeviceStatus;
    stsError                : BOOL;
    stsErrorId              : UDINT;
END_VAR

VAR CONSTANT
    MAX_READ_SIGNALS        : UINT := 100;
    MAX_WRITE_SIGNALS       : UINT := 100;
    MAX_READ_BLOCKS         : UINT := 25;
    MAX_WRITE_BLOCKS        : UINT := 25;
    MAX_REGS_PER_BLOCK      : UINT := 125;
    MAX_COILS_PER_BLOCK     : UINT := 2000;
    MAX_SIGNALS_PER_BLOCK   : UINT := 64;
    MAX_BIT_REGISTERS       : UINT := 20;
    GAP_TOLERANCE_REGS      : UINT := 4;
    GAP_TOLERANCE_COILS     : UINT := 16;
    BIT_INDEX_NA            : BYTE := 255;
END_VAR

VAR
    // Configuration (set via properties before enable)
    cfgIpAddress            : STRING(15) := '192.168.1.1';
    cfgPort                 : UINT := 502;
    cfgUnitId               : BYTE := 1;
    cfgTimeout              : TIME := T#1S;
    cfgPollInterval         : TIME := T#100MS;
    cfgCommandDelay         : TIME := T#10MS;
    cfgWriteCycleInterval   : TIME := T#500MS;
    cfgWordOrder            : E_WordOrder := E_WordOrder.BigEndian;
    cfgMaxConsecFails       : UINT := 3;
    cfgStaleThreshold       : TIME := T#5S;
    cfgReconnectDelay       : TIME := T#2S;
    cfgMaxReconnectAttempts : UINT := 3;
    cfgReadSignalCount      : UINT;
    cfgWriteSignalCount     : UINT;

    // State machine
    _state                  : E_DriverState := E_DriverState.Init;
    _initialized            : BOOL;
    _enablePrev             : BOOL;

    // Connection state (Tc2_ModbusCaller manages TCP internally per FB call;
    // _socketConnected here means "driver is ready and last operation didn't fail")
    _socketConnected        : BOOL;
    _connectAttempts        : UINT;
    _disconnectPending      : BOOL;

    // Timing
    tonPollInterval         : TON;
    tonWriteInterval        : TON;
    tonCommandDelay         : TON;
    tonTimeout              : TON;
    tonReconnectDelay       : TON;
    _lastGoodReadTime       : TIME;
    _lastGoodWriteTime      : TIME;

    // Parsed configuration
    _arrParsedRead          : ARRAY[1..100] OF ST_ParsedSignal;
    _arrParsedWrite         : ARRAY[1..100] OF ST_ParsedSignal;

    // Optimized blocks
    _arrReadBlocks          : ARRAY[1..25] OF ST_ReadBlock;
    _readBlockCount         : UINT;

    _arrWriteBlocks         : ARRAY[1..25] OF ST_WriteBlock;
    _writeBlockCount        : UINT;

    // Bit register tracking (RMW)
    _arrBitRegisters        : ARRAY[1..20] OF ST_BitRegisterRmw;
    _bitRegisterCount       : UINT;

    // Runtime indices
    _currentBlockIdx        : UINT;
    _currentRmwIdx          : UINT;

    // Raw data buffers
    _arrRawReadBuffer       : ARRAY[0..124] OF WORD;
    _arrRawWriteBuffer      : ARRAY[0..124] OF WORD;

    // Tc2_ModbusCaller function blocks (each manages its own TCP connection)
    fbMbReadCoils           : FB_MBReadCoils;       // FC01
    fbMbReadInputs          : FB_MBReadInputs;      // FC02 (discrete inputs)
    fbMbReadRegs            : FB_MBReadRegs;        // FC03 (holding regs)
    fbMbReadInputRegs       : FB_MBReadInputRegs;   // FC04 (input regs)
    fbMbWriteSingleCoil     : FB_MBWriteSingleCoil; // FC05
    fbMbWriteSingleReg      : FB_MBWriteSingleReg;  // FC06
    fbMbWriteCoils          : FB_MBWriteCoils;      // FC15
    fbMbWriteRegs           : FB_MBWriteRegs;       // FC16

    // Error tracking
    _consecFailures         : UINT;
    _lastMbError            : UDINT;
    _readCycleFailed        : BOOL;     // a block failed in the current read cycle
    _writeCycleFailed       : BOOL;     // a block failed in the current write cycle
    _resetRequest           : BOOL;     // cmdReset(): restart from Init without an enable edge

    // Sorting workspace
    _arrSortIdx             : ARRAY[1..100] OF UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// FB body intentionally empty. All work is performed in the cycle() method,
// which the user must call once per PLC scan after invoking the FB itself.
;]]></ST>
    </Implementation>
    <Method Name="applyBitModifications" Id="{dcdfc097-d520-4757-8c4b-cd77e375abd5}">
      <Declaration><![CDATA[METHOD PRIVATE applyBitModifications
VAR_INPUT
    inpRmwIdx : UINT;
END_VAR
VAR
    _reg        : REFERENCE TO ST_BitRegisterRmw;
    _baseValue  : WORD;
    _bitIdx     : UINT;
    _sigIdx     : UINT;
    _pData      : POINTER TO ST_MBWriteData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_reg REF= _arrBitRegisters[inpRmwIdx];

_baseValue := swapBytes(_reg.readValue);

FOR _bitIdx := 0 TO 15 DO
    IF (_reg.managedBitMask AND SHL(WORD#1, _bitIdx)) <> 0 THEN
        _sigIdx := _reg.arrSignalIndex[_bitIdx];

        IF _sigIdx > 0 THEN
            _pData := inpPtrWriteData + UINT_TO_DWORD(_sigIdx - 1) * SIZEOF(ST_MBWriteData);

            IF _pData^.valueBool THEN
                _baseValue := _baseValue OR SHL(WORD#1, _bitIdx);
            ELSE
                _baseValue := _baseValue AND NOT SHL(WORD#1, _bitIdx);
            END_IF
        END_IF
    END_IF
END_FOR

_reg.writeValue := _baseValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkReadComplete" Id="{d5095362-abcf-49bc-9904-d9492d145606}">
      <Declaration><![CDATA[METHOD PRIVATE checkReadComplete : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE _arrReadBlocks[_currentBlockIdx].functionCode OF
    1:
        fbMbReadCoils(bExecute := FALSE);
        checkReadComplete := NOT fbMbReadCoils.bBusy;
    2:
        fbMbReadInputs(bExecute := FALSE);
        checkReadComplete := NOT fbMbReadInputs.bBusy;
    3:
        fbMbReadRegs(bExecute := FALSE);
        checkReadComplete := NOT fbMbReadRegs.bBusy;
    4:
        fbMbReadInputRegs(bExecute := FALSE);
        checkReadComplete := NOT fbMbReadInputRegs.bBusy;
ELSE
    // RMW read path uses fbMbReadRegs unconditionally.
    fbMbReadRegs(bExecute := FALSE);
    checkReadComplete := NOT fbMbReadRegs.bBusy;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkStaleData" Id="{f407b87e-5eaf-4101-8e55-f46fd34fb869}">
      <Declaration><![CDATA[METHOD PRIVATE checkStaleData
VAR
    _i          : UINT;
    _pResult    : POINTER TO ST_MBReadResult;
    _elapsed    : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_elapsed := TIME() - _lastGoodReadTime;

IF _elapsed > cfgStaleThreshold THEN
    FOR _i := 1 TO cfgReadSignalCount DO
        _pResult := inpPtrReadResults + UINT_TO_DWORD(_i - 1) * SIZEOF(ST_MBReadResult);

        IF _pResult^.quality = E_SignalQuality.Good THEN
            _pResult^.quality := E_SignalQuality.UncertainStale;
        END_IF
    END_FOR
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkWriteComplete" Id="{3668d78b-676d-4a0b-953d-f7ace7eeb00c}">
      <Declaration><![CDATA[METHOD PRIVATE checkWriteComplete : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _state = E_DriverState.WriteWait THEN
    IF _arrWriteBlocks[_currentBlockIdx].area = E_MBArea.Coils THEN
        fbMbWriteCoils(bExecute := FALSE);
        checkWriteComplete := NOT fbMbWriteCoils.bBusy;
    ELSE
        fbMbWriteRegs(bExecute := FALSE);
        checkWriteComplete := NOT fbMbWriteRegs.bBusy;
    END_IF
ELSE
    fbMbWriteSingleReg(bExecute := FALSE);
    checkWriteComplete := NOT fbMbWriteSingleReg.bBusy;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="cmdReset" Id="{4f0d507f-bb4e-4070-8d68-dfce59acdbc0}">
      <Declaration><![CDATA[// Recover a Faulted (or errored) driver without toggling inpEnable: it restarts from Init on
// the next cycle() — re-parses the configuration and resumes polling. No effect while disabled.
METHOD PUBLIC cmdReset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF inpEnable THEN
    _state := E_DriverState.Init;
    _resetRequest := TRUE;
    cmdReset := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="combineWords" Id="{27fa7240-bb0a-4728-8a80-25f819de38bb}">
      <Declaration><![CDATA[METHOD PRIVATE combineWords : DWORD
VAR_INPUT
    inpWord0        : WORD;
    inpWord1        : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cfgWordOrder = E_WordOrder.BigEndian THEN
    combineWords := SHL(WORD_TO_DWORD(inpWord0), 16) OR WORD_TO_DWORD(inpWord1);
ELSE
    combineWords := SHL(WORD_TO_DWORD(inpWord1), 16) OR WORD_TO_DWORD(inpWord0);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="commandDelay" Id="{5398d53f-7ea6-4ddc-9612-586aca22437b}">
      <Declaration><![CDATA[PROPERTY PUBLIC commandDelay : TIME
]]></Declaration>
      <Get Name="Get" Id="{416f4204-869d-4247-8338-1fb3351c178a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[commandDelay := cfgCommandDelay;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{7c012c75-0059-405b-af23-9f4a9c2e6c41}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _initialized THEN
    cfgCommandDelay := commandDelay;
END_IF
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="cycle" Id="{5bd2019c-4a0b-4ac9-8220-067fe3ecbac3}">
      <Declaration><![CDATA[METHOD PUBLIC cycle
VAR
    _risingEnable   : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_risingEnable := inpEnable AND NOT _enablePrev;
_enablePrev := inpEnable;

IF NOT inpEnable THEN
    disable();
    RETURN;
END_IF

IF _initialized AND _socketConnected THEN
    stsStatus.timeSinceLastGoodRead := TIME() - _lastGoodReadTime;
    stsStatus.timeSinceLastGoodWrite := TIME() - _lastGoodWriteTime;
END_IF

CASE _state OF

    E_DriverState.Init:
        IF _risingEnable OR _resetRequest THEN
            _resetRequest := FALSE;
            reset();
            _state := E_DriverState.ParseConfig;
        END_IF

    E_DriverState.ParseConfig:
        IF parseAllConfigs() THEN
            _state := E_DriverState.OptimizeBlocks;
        ELSE
            stsError := TRUE;
            _state := E_DriverState.Error;
        END_IF

    E_DriverState.OptimizeBlocks:
        optimizeReadBlocks();
        optimizeWriteBlocks();
        identifyBitRegisters();

        stsStatus.readBlockCount := _readBlockCount;
        stsStatus.writeBlockCount := _writeBlockCount;
        stsStatus.bitRegisterCount := _bitRegisterCount;

        _initialized := TRUE;
        _state := E_DriverState.Connecting;

    E_DriverState.Connecting:
        // Tc2_ModbusCaller manages TCP internally per FB call; no explicit connect.
        // Treat the driver as "ready to talk" once configs are parsed.
        _socketConnected := TRUE;
        _connectAttempts := 0;
        stsStatus.connected := TRUE;
        stsStatus.reconnectAttempts := 0;
        _lastGoodReadTime := TIME();
        _lastGoodWriteTime := TIME();
        _state := E_DriverState.Ready;

    E_DriverState.ConnectWait:
        // Vestigial state retained for E_DriverState compatibility; transition to Ready.
        _state := E_DriverState.Ready;

    E_DriverState.ReconnectWait:
        tonReconnectDelay(IN := TRUE, PT := cfgReconnectDelay);
        IF tonReconnectDelay.Q THEN
            tonReconnectDelay(IN := FALSE);
            _socketConnected := TRUE;
            stsStatus.connected := TRUE;
            _state := E_DriverState.Ready;
        END_IF

    E_DriverState.Disconnecting:
        // No socket to disconnect (Tc2_ModbusCaller is per-call).
        _socketConnected := FALSE;
        stsStatus.connected := FALSE;
        stsStatus.readCycleActive := FALSE;
        stsStatus.writeCycleActive := FALSE;
        _consecFailures := 0;           // the retry gets its own maxConsecFails budget
        _state := E_DriverState.DisconnectWait;

    E_DriverState.DisconnectWait:
        IF _disconnectPending THEN
            _disconnectPending := FALSE;
            tonReconnectDelay(IN := FALSE);
            _state := E_DriverState.ReconnectWait;
        ELSE
            _state := E_DriverState.Init;
        END_IF

    E_DriverState.Ready:
        tonPollInterval(IN := TRUE, PT := cfgPollInterval);
        IF tonPollInterval.Q THEN
            tonPollInterval(IN := FALSE);
            IF _readBlockCount > 0 THEN
                _state := E_DriverState.ReadStart;
                RETURN;
            END_IF
        END_IF

        tonWriteInterval(IN := TRUE, PT := cfgWriteCycleInterval);
        IF tonWriteInterval.Q THEN
            tonWriteInterval(IN := FALSE);
            IF NOT inpHoldWrites AND (_writeBlockCount > 0 OR _bitRegisterCount > 0) THEN
                _state := E_DriverState.WriteStart;
                RETURN;
            END_IF
        END_IF

        checkStaleData();

    E_DriverState.ReadStart:
        _currentBlockIdx := 1;
        _readCycleFailed := FALSE;
        stsStatus.readCycleActive := TRUE;
        _state := E_DriverState.ReadSend;

    E_DriverState.ReadSend:
        IF _currentBlockIdx > _readBlockCount THEN
            _state := E_DriverState.ReadComplete;
        ELSE
            sendReadRequest(_currentBlockIdx);
            _state := E_DriverState.ReadWait;
        END_IF

    E_DriverState.ReadWait:
        tonTimeout(IN := TRUE, PT := cfgTimeout);

        IF checkReadComplete() THEN
            tonTimeout(IN := FALSE);
            IF readSucceeded() THEN
                processReadBlock(_currentBlockIdx);
                _consecFailures := 0;
            ELSE
                handleBlockError(_currentBlockIdx, TRUE);
            END_IF
            IF _state = E_DriverState.ReadWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                _state := E_DriverState.ReadDelay;
            END_IF

        ELSIF tonTimeout.Q THEN
            tonTimeout(IN := FALSE);
            handleBlockError(_currentBlockIdx, TRUE);
            IF _state = E_DriverState.ReadWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                _state := E_DriverState.ReadDelay;
            END_IF
        END_IF

    E_DriverState.ReadDelay:
        tonCommandDelay(IN := TRUE, PT := cfgCommandDelay);
        IF tonCommandDelay.Q THEN
            tonCommandDelay(IN := FALSE);
            _currentBlockIdx := _currentBlockIdx + 1;
            _state := E_DriverState.ReadSend;
        END_IF

    E_DriverState.ReadComplete:
        stsStatus.readCycleActive := FALSE;
        stsStatus.totalReadCycles := stsStatus.totalReadCycles + 1;
        // Only a cycle in which EVERY block succeeded is a good read. Stamping it regardless
        // kept timeSinceLastGoodRead near zero (and stale marking off) while every read failed.
        IF NOT _readCycleFailed THEN
            _lastGoodReadTime := TIME();
            _connectAttempts := 0;      // link proven again: the reconnect budget starts over
            stsStatus.reconnectAttempts := 0;
        END_IF
        _state := E_DriverState.Ready;

    E_DriverState.WriteStart:
        _currentBlockIdx := 1;
        _writeCycleFailed := FALSE;
        _currentRmwIdx := 0;
        stsStatus.writeCycleActive := TRUE;
        _state := E_DriverState.WriteSend;

    E_DriverState.WriteSend:
        WHILE _currentBlockIdx <= _writeBlockCount DO
            IF NOT _arrWriteBlocks[_currentBlockIdx].containsBitSignals THEN
                packAndSendWriteBlock(_currentBlockIdx);
                _state := E_DriverState.WriteWait;
                RETURN;
            END_IF
            _currentBlockIdx := _currentBlockIdx + 1;
        END_WHILE

        IF _currentRmwIdx < _bitRegisterCount THEN
            _currentRmwIdx := _currentRmwIdx + 1;
            _state := E_DriverState.RmwReadSend;
        ELSE
            _state := E_DriverState.WriteComplete;
        END_IF

    E_DriverState.WriteWait:
        tonTimeout(IN := TRUE, PT := cfgTimeout);

        IF checkWriteComplete() THEN
            tonTimeout(IN := FALSE);
            IF writeSucceeded() THEN
                updateWriteStatus(_currentBlockIdx, TRUE);
                _consecFailures := 0;
            ELSE
                handleBlockError(_currentBlockIdx, FALSE);
                updateWriteStatus(_currentBlockIdx, FALSE);
            END_IF
            IF _state = E_DriverState.WriteWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                _state := E_DriverState.WriteDelay;
            END_IF

        ELSIF tonTimeout.Q THEN
            tonTimeout(IN := FALSE);
            handleBlockError(_currentBlockIdx, FALSE);
            updateWriteStatus(_currentBlockIdx, FALSE);
            IF _state = E_DriverState.WriteWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                _state := E_DriverState.WriteDelay;
            END_IF
        END_IF

    E_DriverState.WriteDelay:
        tonCommandDelay(IN := TRUE, PT := cfgCommandDelay);
        IF tonCommandDelay.Q THEN
            tonCommandDelay(IN := FALSE);
            _currentBlockIdx := _currentBlockIdx + 1;
            _state := E_DriverState.WriteSend;
        END_IF

    E_DriverState.RmwReadSend:
        sendRmwReadRequest(_currentRmwIdx);
        _state := E_DriverState.RmwReadWait;

    E_DriverState.RmwReadWait:
        tonTimeout(IN := TRUE, PT := cfgTimeout);

        IF checkReadComplete() THEN
            tonTimeout(IN := FALSE);
            IF readSucceeded() THEN
                _arrBitRegisters[_currentRmwIdx].readValue := _arrRawReadBuffer[0];
                _state := E_DriverState.RmwModify;
            ELSE
                handleRmwError(_currentRmwIdx);
                IF _state = E_DriverState.RmwReadWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                    _state := E_DriverState.RmwDelay;
                END_IF
            END_IF

        ELSIF tonTimeout.Q THEN
            tonTimeout(IN := FALSE);
            handleRmwError(_currentRmwIdx);
            IF _state = E_DriverState.RmwReadWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                _state := E_DriverState.RmwDelay;
            END_IF
        END_IF

    E_DriverState.RmwModify:
        applyBitModifications(_currentRmwIdx);
        _state := E_DriverState.RmwWriteSend;

    E_DriverState.RmwWriteSend:
        sendRmwWriteRequest(_currentRmwIdx);
        _state := E_DriverState.RmwWriteWait;

    E_DriverState.RmwWriteWait:
        tonTimeout(IN := TRUE, PT := cfgTimeout);

        IF checkWriteComplete() THEN
            tonTimeout(IN := FALSE);
            IF writeSucceeded() THEN
                updateRmwStatus(_currentRmwIdx, TRUE);
                _consecFailures := 0;
            ELSE
                handleRmwError(_currentRmwIdx);
                updateRmwStatus(_currentRmwIdx, FALSE);
            END_IF
            IF _state = E_DriverState.RmwWriteWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                _state := E_DriverState.RmwDelay;
            END_IF

        ELSIF tonTimeout.Q THEN
            tonTimeout(IN := FALSE);
            handleRmwError(_currentRmwIdx);
            updateRmwStatus(_currentRmwIdx, FALSE);
            IF _state = E_DriverState.RmwWriteWait THEN   // the error handler may have moved us to Disconnecting/Faulted
                _state := E_DriverState.RmwDelay;
            END_IF
        END_IF

    E_DriverState.RmwDelay:
        tonCommandDelay(IN := TRUE, PT := cfgCommandDelay);
        IF tonCommandDelay.Q THEN
            tonCommandDelay(IN := FALSE);
            IF _currentRmwIdx < _bitRegisterCount THEN
                _currentRmwIdx := _currentRmwIdx + 1;
                _state := E_DriverState.RmwReadSend;
            ELSE
                _state := E_DriverState.WriteComplete;
            END_IF
        END_IF

    E_DriverState.WriteComplete:
        stsStatus.writeCycleActive := FALSE;
        stsStatus.totalWriteCycles := stsStatus.totalWriteCycles + 1;
        IF NOT _writeCycleFailed THEN
            _lastGoodWriteTime := TIME();
        END_IF
        _state := E_DriverState.Ready;

    E_DriverState.Error:
        stsError := TRUE;
        stsStatus.totalErrors := stsStatus.totalErrors + 1;
        _disconnectPending := TRUE;
        _state := E_DriverState.Disconnecting;

    E_DriverState.Faulted:
        stsStatus.faulted := TRUE;
        stsError := TRUE;

END_CASE

stsStatus.currentState := _state;
stsStatus.consecutiveFailures := _consecFailures;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="dintToWords" Id="{b6660868-e0d1-4b30-abe7-2b26b087636f}">
      <Declaration><![CDATA[METHOD PRIVATE dintToWords
VAR_INPUT
    inpValue        : DINT;
END_VAR
VAR_OUTPUT
    stsWord0        : WORD;
    stsWord1        : WORD;
END_VAR
VAR
    _dword          : DWORD;
    _w0, _w1        : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_dword := DINT_TO_DWORD(inpValue);
splitDword(inpValue := _dword, stsWord0 => _w0, stsWord1 => _w1);
stsWord0 := swapBytes(_w0);
stsWord1 := swapBytes(_w1);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="disable" Id="{bb29eacf-e7ae-4c57-a01a-0711812f5ba6}">
      <Declaration><![CDATA[METHOD PRIVATE disable
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Tc2_ModbusCaller has no socket to tear down explicitly.
_socketConnected := FALSE;

tonPollInterval(IN := FALSE);
tonWriteInterval(IN := FALSE);
tonCommandDelay(IN := FALSE);
tonTimeout(IN := FALSE);
tonReconnectDelay(IN := FALSE);

// Back to Init from ANY state, Faulted included: re-enabling restarts the driver. (Faulted used
// to survive a disable, which left a faulted driver dead until the PLC restarted.)
_state := E_DriverState.Init;
_resetRequest := FALSE;

_initialized := FALSE;
stsStatus.connected := FALSE;
stsStatus.readCycleActive := FALSE;
stsStatus.writeCycleActive := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="handleBlockError" Id="{195a0432-d58e-45c0-a1cd-3eba77f84282}">
      <Declaration><![CDATA[METHOD PRIVATE handleBlockError
VAR_INPUT
    inpBlockIdx : UINT;
    inpIsRead   : BOOL;
END_VAR
VAR
    _block      : REFERENCE TO ST_ReadBlock;
    _i          : UINT;
    _sigIdx     : UINT;
    _pResult    : POINTER TO ST_MBReadResult;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_consecFailures := _consecFailures + 1;
stsStatus.totalErrors := stsStatus.totalErrors + 1;
IF inpIsRead THEN
    _readCycleFailed := TRUE;
ELSE
    _writeCycleFailed := TRUE;
END_IF

IF inpIsRead THEN
    _block REF= _arrReadBlocks[inpBlockIdx];

    FOR _i := 1 TO _block.signalCount DO
        _sigIdx := _block.arrSignalIndex[_i];
        _pResult := inpPtrReadResults + UINT_TO_DWORD(_sigIdx - 1) * SIZEOF(ST_MBReadResult);
        _pResult^.quality := E_SignalQuality.BadComm;
    END_FOR
END_IF

IF _consecFailures >= cfgMaxConsecFails THEN
    _connectAttempts := _connectAttempts + 1;
    stsStatus.reconnectAttempts := _connectAttempts;

    IF _connectAttempts >= cfgMaxReconnectAttempts THEN
        _state := E_DriverState.Faulted;
    ELSE
        _disconnectPending := TRUE;
        _state := E_DriverState.Disconnecting;
    END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="handleRmwError" Id="{5ec8cef9-ad83-4697-9468-f993aa3fbca6}">
      <Declaration><![CDATA[METHOD PRIVATE handleRmwError
VAR_INPUT
    inpRmwIdx : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_consecFailures := _consecFailures + 1;
stsStatus.totalErrors := stsStatus.totalErrors + 1;
_writeCycleFailed := TRUE;      // RMW runs inside the write cycle

IF _consecFailures >= cfgMaxConsecFails THEN
    _connectAttempts := _connectAttempts + 1;
    stsStatus.reconnectAttempts := _connectAttempts;

    IF _connectAttempts >= cfgMaxReconnectAttempts THEN
        _state := E_DriverState.Faulted;
    ELSE
        _disconnectPending := TRUE;
        _state := E_DriverState.Disconnecting;
    END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="identifyBitRegisters" Id="{31380060-339e-4e1d-96a9-5cfc6a5759d1}">
      <Declaration><![CDATA[METHOD PRIVATE identifyBitRegisters
VAR
    _i, _j          : UINT;
    _addr           : UINT;
    _bitIdx         : BYTE;
    _found          : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bitRegisterCount := 0;

FOR _i := 1 TO cfgWriteSignalCount DO
    IF _arrParsedWrite[_i].valid AND _arrParsedWrite[_i].isBitInRegister THEN
        _addr := _arrParsedWrite[_i].baseAddress;
        _bitIdx := _arrParsedWrite[_i].bitIndex;

        _found := FALSE;
        FOR _j := 1 TO _bitRegisterCount DO
            IF _arrBitRegisters[_j].address = _addr THEN
                _arrBitRegisters[_j].managedBitMask :=
                    _arrBitRegisters[_j].managedBitMask OR SHL(WORD#1, _bitIdx);
                _arrBitRegisters[_j].arrSignalIndex[_bitIdx] := _i;
                _found := TRUE;
                EXIT;
            END_IF
        END_FOR

        IF NOT _found AND _bitRegisterCount < MAX_BIT_REGISTERS THEN
            _bitRegisterCount := _bitRegisterCount + 1;
            _arrBitRegisters[_bitRegisterCount].address := _addr;
            _arrBitRegisters[_bitRegisterCount].managedBitMask := SHL(WORD#1, _bitIdx);
            _arrBitRegisters[_bitRegisterCount].arrSignalIndex[_bitIdx] := _i;
        END_IF
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
