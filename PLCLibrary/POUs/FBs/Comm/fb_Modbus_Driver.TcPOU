      <Declaration><![CDATA[PROPERTY PUBLIC port : UINT
]]></Declaration>
      <Get Name="Get" Id="{a2fb8b2f-e73a-4e92-9cf8-e72937492592}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[port := cfgPort;
]]></ST>
