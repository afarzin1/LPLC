    <Method Name="optimizeReadBlocks" Id="{111b32e2-46e7-4038-b120-9f158b0477b4}">
      <Declaration><![CDATA[METHOD PRIVATE optimizeReadBlocks
VAR
    _i, _j          : UINT;
    _sortCount      : UINT;
    _currentBlock   : UINT;
    _blockStart     : UINT;
    _blockEnd       : UINT;
    _blockArea      : E_MBArea;
    _gapTolerance   : UINT;
    _maxPerBlock    : UINT;
    _nextAddr       : UINT;
    _nextEnd        : UINT;
    _temp           : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_sortCount := 0;
FOR _i := 1 TO cfgReadSignalCount DO
    IF _arrParsedRead[_i].valid THEN
        _sortCount := _sortCount + 1;
        _arrSortIdx[_sortCount] := _i;
    END_IF
END_FOR

IF _sortCount = 0 THEN
    _readBlockCount := 0;
    RETURN;
END_IF

FOR _i := 1 TO _sortCount - 1 DO
    FOR _j := _i + 1 TO _sortCount DO
        IF shouldSwapForSort(_arrSortIdx[_i], _arrSortIdx[_j], TRUE) THEN
            _temp := _arrSortIdx[_i];
            _arrSortIdx[_i] := _arrSortIdx[_j];
            _arrSortIdx[_j] := _temp;
        END_IF
    END_FOR
END_FOR

_currentBlock := 0;
_i := 1;

WHILE _i <= _sortCount DO
    _currentBlock := _currentBlock + 1;
    IF _currentBlock > MAX_READ_BLOCKS THEN
        _currentBlock := _currentBlock - 1;
        EXIT;
    END_IF

    _blockArea := _arrParsedRead[_arrSortIdx[_i]].area;
    _blockStart := _arrParsedRead[_arrSortIdx[_i]].baseAddress;
    _blockEnd := _blockStart + _arrParsedRead[_arrSortIdx[_i]].registerCount - 1;

    IF _blockArea = E_MBArea.Coils OR _blockArea = E_MBArea.DiscreteInputs THEN
        _gapTolerance := GAP_TOLERANCE_COILS;
        _maxPerBlock := MAX_COILS_PER_BLOCK;
    ELSE
        _gapTolerance := GAP_TOLERANCE_REGS;
        _maxPerBlock := MAX_REGS_PER_BLOCK;
    END_IF

    _arrReadBlocks[_currentBlock].area := _blockArea;
    _arrReadBlocks[_currentBlock].startAddress := _blockStart;
    _arrReadBlocks[_currentBlock].signalCount := 1;
    _arrReadBlocks[_currentBlock].arrSignalIndex[1] := _arrSortIdx[_i];
    _arrReadBlocks[_currentBlock].arrOffsetInBlock[1] := 0;
    _arrReadBlocks[_currentBlock].enabled := TRUE;

    CASE _blockArea OF
        E_MBArea.Coils:
            _arrReadBlocks[_currentBlock].functionCode := 1;
        E_MBArea.DiscreteInputs:
            _arrReadBlocks[_currentBlock].functionCode := 2;
        E_MBArea.HoldingRegisters:
            _arrReadBlocks[_currentBlock].functionCode := 3;
        E_MBArea.InputRegisters:
            _arrReadBlocks[_currentBlock].functionCode := 4;
    END_CASE

    _j := _i + 1;
    WHILE _j <= _sortCount DO
        IF _arrParsedRead[_arrSortIdx[_j]].area <> _blockArea THEN
            EXIT;
        END_IF

        _nextAddr := _arrParsedRead[_arrSortIdx[_j]].baseAddress;
        _nextEnd := _nextAddr + _arrParsedRead[_arrSortIdx[_j]].registerCount - 1;

        IF _nextAddr > (_blockEnd + _gapTolerance + 1) THEN
            EXIT;
        END_IF

        IF (_nextEnd - _blockStart + 1) > _maxPerBlock THEN
            EXIT;
        END_IF

        _arrReadBlocks[_currentBlock].signalCount :=
            _arrReadBlocks[_currentBlock].signalCount + 1;
        _arrReadBlocks[_currentBlock].arrSignalIndex[_arrReadBlocks[_currentBlock].signalCount] :=
            _arrSortIdx[_j];
        _arrReadBlocks[_currentBlock].arrOffsetInBlock[_arrReadBlocks[_currentBlock].signalCount] :=
            _nextAddr - _blockStart;

        IF _nextEnd > _blockEnd THEN
            _blockEnd := _nextEnd;
        END_IF

        _j := _j + 1;
    END_WHILE

    _arrReadBlocks[_currentBlock].quantity := _blockEnd - _blockStart + 1;
    _i := _j;
END_WHILE

_readBlockCount := _currentBlock;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="optimizeWriteBlocks" Id="{2abaa8ad-d781-4be3-98d9-7fb6bd199f53}">
      <Declaration><![CDATA[METHOD PRIVATE optimizeWriteBlocks
VAR
    _i, _j          : UINT;
    _sortCount      : UINT;
    _currentBlock   : UINT;
    _blockStart     : UINT;
    _blockEnd       : UINT;
    _blockArea      : E_MBArea;
    _gapTolerance   : UINT;
    _maxPerBlock    : UINT;
    _nextAddr       : UINT;
    _nextEnd        : UINT;
    _temp           : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_sortCount := 0;
FOR _i := 1 TO cfgWriteSignalCount DO
    IF _arrParsedWrite[_i].valid AND NOT _arrParsedWrite[_i].isBitInRegister THEN
        _sortCount := _sortCount + 1;
        _arrSortIdx[_sortCount] := _i;
    END_IF
END_FOR

IF _sortCount = 0 THEN
    _writeBlockCount := 0;
    RETURN;
END_IF

FOR _i := 1 TO _sortCount - 1 DO
    FOR _j := _i + 1 TO _sortCount DO
        IF shouldSwapForSort(_arrSortIdx[_i], _arrSortIdx[_j], FALSE) THEN
            _temp := _arrSortIdx[_i];
            _arrSortIdx[_i] := _arrSortIdx[_j];
            _arrSortIdx[_j] := _temp;
        END_IF
    END_FOR
END_FOR

_currentBlock := 0;
_i := 1;

WHILE _i <= _sortCount DO
    _currentBlock := _currentBlock + 1;
    IF _currentBlock > MAX_WRITE_BLOCKS THEN
        _currentBlock := _currentBlock - 1;
        EXIT;
    END_IF

    _blockArea := _arrParsedWrite[_arrSortIdx[_i]].area;
    _blockStart := _arrParsedWrite[_arrSortIdx[_i]].baseAddress;
    _blockEnd := _blockStart + _arrParsedWrite[_arrSortIdx[_i]].registerCount - 1;

    IF _blockArea = E_MBArea.Coils THEN
        _gapTolerance := GAP_TOLERANCE_COILS;
        _maxPerBlock := MAX_COILS_PER_BLOCK;
    ELSE
        _gapTolerance := GAP_TOLERANCE_REGS;
        _maxPerBlock := MAX_REGS_PER_BLOCK;
    END_IF

    _arrWriteBlocks[_currentBlock].area := _blockArea;
    _arrWriteBlocks[_currentBlock].startAddress := _blockStart;
    _arrWriteBlocks[_currentBlock].signalCount := 1;
    _arrWriteBlocks[_currentBlock].arrSignalIndex[1] := _arrSortIdx[_i];
    _arrWriteBlocks[_currentBlock].arrOffsetInBlock[1] := 0;
    _arrWriteBlocks[_currentBlock].enabled := TRUE;
    _arrWriteBlocks[_currentBlock].containsBitSignals := FALSE;

    CASE _blockArea OF
        E_MBArea.Coils:
            _arrWriteBlocks[_currentBlock].functionCode := 15;
        E_MBArea.HoldingRegisters:
            _arrWriteBlocks[_currentBlock].functionCode := 16;
    END_CASE

    _j := _i + 1;
    WHILE _j <= _sortCount DO
        IF _arrParsedWrite[_arrSortIdx[_j]].area <> _blockArea THEN
            EXIT;
        END_IF

        _nextAddr := _arrParsedWrite[_arrSortIdx[_j]].baseAddress;
        _nextEnd := _nextAddr + _arrParsedWrite[_arrSortIdx[_j]].registerCount - 1;

        IF _nextAddr > (_blockEnd + _gapTolerance + 1) THEN
            EXIT;
        END_IF

        IF (_nextEnd - _blockStart + 1) > _maxPerBlock THEN
            EXIT;
        END_IF

        _arrWriteBlocks[_currentBlock].signalCount :=
            _arrWriteBlocks[_currentBlock].signalCount + 1;
        _arrWriteBlocks[_currentBlock].arrSignalIndex[_arrWriteBlocks[_currentBlock].signalCount] :=
            _arrSortIdx[_j];
        _arrWriteBlocks[_currentBlock].arrOffsetInBlock[_arrWriteBlocks[_currentBlock].signalCount] :=
            _nextAddr - _blockStart;

        IF _nextEnd > _blockEnd THEN
            _blockEnd := _nextEnd;
        END_IF

        _j := _j + 1;
    END_WHILE

    _arrWriteBlocks[_currentBlock].quantity := _blockEnd - _blockStart + 1;
    _i := _j;
END_WHILE

_writeBlockCount := _currentBlock;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="packAndSendWriteBlock" Id="{d3f61157-24e2-4bc2-acd4-c929c647d134}">
      <Declaration><![CDATA[METHOD PRIVATE packAndSendWriteBlock
VAR_INPUT
    inpBlockIdx : UINT;
END_VAR
VAR
    _block      : REFERENCE TO ST_WriteBlock;
    _i          : UINT;
    _sigIdx     : UINT;
    _offset     : UINT;
    _parsed     : REFERENCE TO ST_ParsedSignal;
    _pData      : POINTER TO ST_MBWriteData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_block REF= _arrWriteBlocks[inpBlockIdx];

MEMSET(ADR(_arrRawWriteBuffer), 0, SIZEOF(_arrRawWriteBuffer));

FOR _i := 1 TO _block.signalCount DO
    _sigIdx := _block.arrSignalIndex[_i];
    _offset := _block.arrOffsetInBlock[_i];
    _parsed REF= _arrParsedWrite[_sigIdx];

    _pData := inpPtrWriteData + UINT_TO_DWORD(_sigIdx - 1) * SIZEOF(ST_MBWriteData);

    CASE _parsed.dataType OF
        E_MBDataType.mbReal32:
            realToWords(
                inpValue := _pData^.valueReal,
                stsWord0 => _arrRawWriteBuffer[_offset],
                stsWord1 => _arrRawWriteBuffer[_offset + 1]
            );

        E_MBDataType.mbInt32:
            dintToWords(
                inpValue := _pData^.valueDint,
                stsWord0 => _arrRawWriteBuffer[_offset],
                stsWord1 => _arrRawWriteBuffer[_offset + 1]
            );

        E_MBDataType.mbUInt32:
            udintToWords(
                inpValue := _pData^.valueUdint,
                stsWord0 => _arrRawWriteBuffer[_offset],
                stsWord1 => _arrRawWriteBuffer[_offset + 1]
            );

        E_MBDataType.mbInt16:
            _arrRawWriteBuffer[_offset] := swapBytes(INT_TO_WORD(_pData^.valueInt));

        E_MBDataType.mbUInt16:
            _arrRawWriteBuffer[_offset] := swapBytes(UINT_TO_WORD(_pData^.valueUint));

        E_MBDataType.mbWord16:
            _arrRawWriteBuffer[_offset] := swapBytes(_pData^.valueWord);

        E_MBDataType.mbBit:
            IF _pData^.valueBool THEN
                _arrRawWriteBuffer[_offset / 16] :=
                    _arrRawWriteBuffer[_offset / 16] OR SHL(WORD#1, _offset MOD 16);
            END_IF
    END_CASE
END_FOR

IF _block.area = E_MBArea.Coils THEN
    fbMbWriteCoils(
        sIPAddr     := cfgIpAddress,
        nTCPPort    := cfgPort,
        nUnitID     := cfgUnitId,
        nQuantity   := _block.quantity,
        nMBAddr     := _block.startAddress,
        cbLength    := UINT_TO_UDINT(_block.quantity + 7) / 8,
        pSrcAddr    := ADR(_arrRawWriteBuffer),
        bExecute    := TRUE,
        tTimeout    := cfgTimeout
    );
ELSE
    fbMbWriteRegs(
        sIPAddr     := cfgIpAddress,
        nTCPPort    := cfgPort,
        nUnitID     := cfgUnitId,
        nQuantity   := _block.quantity,
        nMBAddr     := _block.startAddress,
        cbLength    := UINT_TO_UDINT(_block.quantity) * 2,
        pSrcAddr    := ADR(_arrRawWriteBuffer),
        bExecute    := TRUE,
        tTimeout    := cfgTimeout
    );
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="parseAllConfigs" Id="{ea14179c-9180-4ee6-8f1c-a22739a6ad21}">
      <Declaration><![CDATA[METHOD PRIVATE parseAllConfigs : BOOL
VAR
    _i              : UINT;
    _pConfig        : POINTER TO ST_MBSignalConfig;
    _pResult        : POINTER TO ST_MBReadResult;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cfgReadSignalCount > 0 AND (inpPtrReadConfig = 0 OR inpPtrReadResults = 0) THEN
    stsErrorId := 16#8001;
    RETURN;
END_IF

IF cfgWriteSignalCount > 0 AND (inpPtrWriteConfig = 0 OR inpPtrWriteData = 0) THEN
    stsErrorId := 16#8002;
    RETURN;
END_IF

FOR _i := 1 TO cfgReadSignalCount DO
    _pConfig := inpPtrReadConfig + UINT_TO_DWORD(_i - 1) * SIZEOF(ST_MBSignalConfig);

    parseModbusAddress(
        inpModbusAddr := _pConfig^.modbusAddr,
        inpDataType := _pConfig^.dataType,
        inpBitIndex := _pConfig^.bitIndex,
        stsParsed => _arrParsedRead[_i]
    );

    IF NOT _arrParsedRead[_i].valid THEN
        _pResult := inpPtrReadResults + UINT_TO_DWORD(_i - 1) * SIZEOF(ST_MBReadResult);
        _pResult^.quality := E_SignalQuality.BadConfig;
    END_IF
END_FOR

FOR _i := 1 TO cfgWriteSignalCount DO
    _pConfig := inpPtrWriteConfig + UINT_TO_DWORD(_i - 1) * SIZEOF(ST_MBSignalConfig);

    parseModbusAddress(
        inpModbusAddr := _pConfig^.modbusAddr,
        inpDataType := _pConfig^.dataType,
        inpBitIndex := _pConfig^.bitIndex,
        stsParsed => _arrParsedWrite[_i]
    );
END_FOR

parseAllConfigs := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="parseModbusAddress" Id="{bb13278e-6c39-4b23-bb4d-809495d67275}">
      <Declaration><![CDATA[METHOD PRIVATE parseModbusAddress
VAR_INPUT
    inpModbusAddr   : UDINT;
    inpDataType     : E_MBDataType;
    inpBitIndex     : BYTE;
END_VAR
VAR_OUTPUT
    stsParsed       : ST_ParsedSignal;
END_VAR
VAR
    _areaCode       : UDINT;
    _offset         : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stsParsed.valid := FALSE;
stsParsed.dataType := inpDataType;
stsParsed.bitIndex := inpBitIndex;

IF inpModbusAddr >= 400001 THEN
    _areaCode := 4;
    _offset := (inpModbusAddr MOD 100000) - 1;
ELSIF inpModbusAddr >= 40001 THEN
    _areaCode := 4;
    _offset := (inpModbusAddr MOD 10000) - 1;
ELSIF inpModbusAddr >= 30001 THEN
    _areaCode := 3;
    _offset := (inpModbusAddr MOD 10000) - 1;
ELSIF inpModbusAddr >= 10001 THEN
    _areaCode := 1;
    _offset := (inpModbusAddr MOD 10000) - 1;
ELSIF inpModbusAddr >= 1 THEN
    _areaCode := 0;
    _offset := inpModbusAddr - 1;
ELSE
    RETURN;
END_IF

IF _offset > 65535 THEN
    RETURN;
END_IF

stsParsed.baseAddress := UDINT_TO_UINT(_offset);

CASE _areaCode OF
    0:
        stsParsed.area := E_MBArea.Coils;
        stsParsed.registerCount := 1;
        stsParsed.bitIndex := BIT_INDEX_NA;
        stsParsed.isBitInRegister := FALSE;

    1:
        stsParsed.area := E_MBArea.DiscreteInputs;
        stsParsed.registerCount := 1;
        stsParsed.bitIndex := BIT_INDEX_NA;
        stsParsed.isBitInRegister := FALSE;

    3:
        stsParsed.area := E_MBArea.InputRegisters;
        IF inpDataType = E_MBDataType.mbBit AND inpBitIndex < 16 THEN
            stsParsed.isBitInRegister := TRUE;
        END_IF

    4:
        stsParsed.area := E_MBArea.HoldingRegisters;
        IF inpDataType = E_MBDataType.mbBit AND inpBitIndex < 16 THEN
            stsParsed.isBitInRegister := TRUE;
        END_IF

ELSE
    RETURN;
END_CASE

CASE inpDataType OF
    E_MBDataType.mbReal32,
    E_MBDataType.mbInt32,
    E_MBDataType.mbUInt32:
        stsParsed.registerCount := 2;

    E_MBDataType.mbInt16,
    E_MBDataType.mbUInt16,
    E_MBDataType.mbWord16,
    E_MBDataType.mbBit:
        stsParsed.registerCount := 1;
END_CASE

stsParsed.valid := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="pollInterval" Id="{fe7c55a8-e053-4894-806f-5a4ea1468709}">
      <Declaration><![CDATA[PROPERTY PUBLIC pollInterval : TIME
]]></Declaration>
