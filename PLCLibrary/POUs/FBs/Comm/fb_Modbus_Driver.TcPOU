    <Method Name="writeSucceeded" Id="{c69c6b3b-e83c-4cd4-9ebe-424caf276299}">
      <Declaration><![CDATA[METHOD PRIVATE writeSucceeded : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _state = E_DriverState.WriteWait THEN
    IF _arrWriteBlocks[_currentBlockIdx].area = E_MBArea.Coils THEN
        writeSucceeded := NOT fbMbWriteCoils.bError;
        IF fbMbWriteCoils.bError THEN
            _lastMbError := 1;
        END_IF
    ELSE
        writeSucceeded := NOT fbMbWriteRegs.bError;
        IF fbMbWriteRegs.bError THEN
            _lastMbError := 1;
        END_IF
    END_IF
ELSE
    writeSucceeded := NOT fbMbWriteSingleReg.bError;
    IF fbMbWriteSingleReg.bError THEN
        _lastMbError := 1;
    END_IF
END_IF

stsStatus.lastErrorCode := _lastMbError;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>