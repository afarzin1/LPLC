    </Property>
    <Method Name="updateRmwStatus" Id="{96c4579c-45cf-47a0-b977-0579b1d0d0f1}">
      <Declaration><![CDATA[METHOD PRIVATE updateRmwStatus
VAR_INPUT
    inpRmwIdx   : UINT;
    inpSuccess  : BOOL;
END_VAR
VAR
    _reg        : REFERENCE TO ST_BitRegisterRmw;
    _bitIdx     : UINT;
    _sigIdx     : UINT;
    _pData      : POINTER TO ST_MBWriteData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_reg REF= _arrBitRegisters[inpRmwIdx];

FOR _bitIdx := 0 TO 15 DO
    IF (_reg.managedBitMask AND SHL(WORD#1, _bitIdx)) <> 0 THEN
        _sigIdx := _reg.arrSignalIndex[_bitIdx];

        IF _sigIdx > 0 THEN
            _pData := inpPtrWriteData + UINT_TO_DWORD(_sigIdx - 1) * SIZEOF(ST_MBWriteData);

            _pData^.writeSuccess := inpSuccess;
            _pData^.writeError := NOT inpSuccess;

            IF inpSuccess THEN
                _pData^.writeCount := _pData^.writeCount + 1;
            END_IF
        END_IF
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="updateWriteStatus" Id="{85207c6a-bd91-42ab-b8ed-04c832d263d4}">
      <Declaration><![CDATA[METHOD PRIVATE updateWriteStatus
VAR_INPUT
    inpBlockIdx : UINT;
    inpSuccess  : BOOL;
END_VAR
VAR
    _block      : REFERENCE TO ST_WriteBlock;
    _i          : UINT;
    _sigIdx     : UINT;
    _pData      : POINTER TO ST_MBWriteData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_block REF= _arrWriteBlocks[inpBlockIdx];

FOR _i := 1 TO _block.signalCount DO
    _sigIdx := _block.arrSignalIndex[_i];
    _pData := inpPtrWriteData + UINT_TO_DWORD(_sigIdx - 1) * SIZEOF(ST_MBWriteData);

    _pData^.writeSuccess := inpSuccess;
    _pData^.writeError := NOT inpSuccess;

    IF inpSuccess THEN
        _pData^.writeCount := _pData^.writeCount + 1;
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
