    <Method Name="swapBytes" Id="{507b3232-e9d4-4da7-8d6e-e43f6a6cebb3}">
      <Declaration><![CDATA[METHOD PRIVATE swapBytes : WORD
VAR_INPUT
    inpValue : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Tc2_ModbusCaller (FB_MBReadRegs / FB_MBWriteRegs) already converts between
// network and host byte order — each WORD in _arrRawReadBuffer / _arrRawWriteBuffer
// is already the correct host-order register value. No additional byte swap needed.
swapBytes := inpValue;
]]></ST>
      </Implementation>
    </Method>
