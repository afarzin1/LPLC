    <Property Name="writeSignalCount" Id="{56476bc2-7f98-4550-a6dd-16c8b5fa0717}">
      <Declaration><![CDATA[PROPERTY PUBLIC writeSignalCount : UINT
]]></Declaration>
      <Get Name="Get" Id="{9befd42c-6bb9-4d6f-93ff-e87a52cc78d0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[writeSignalCount := cfgWriteSignalCount;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{86511c04-03c9-4c17-aa60-aef6c37e5e01}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _initialized THEN
