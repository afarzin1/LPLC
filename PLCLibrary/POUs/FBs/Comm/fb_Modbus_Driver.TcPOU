    <Method Name="wordsToDint" Id="{d96d33ab-dcc4-4c5d-8a52-e29b45064117}">
      <Declaration><![CDATA[METHOD PRIVATE wordsToDint : DINT
VAR_INPUT
    inpWord0        : WORD;
    inpWord1        : WORD;
END_VAR
VAR
    _w0             : WORD;
    _w1             : WORD;
    _dword          : DWORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_w0 := swapBytes(inpWord0);
_w1 := swapBytes(inpWord1);
_dword := combineWords(_w0, _w1);
wordsToDint := DWORD_TO_DINT(_dword);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="wordsToReal" Id="{0bd31e58-b420-4c0e-a0ed-ad2b77de77c9}">
      <Declaration><![CDATA[METHOD PRIVATE wordsToReal : REAL
VAR_INPUT
    inpWord0        : WORD;
    inpWord1        : WORD;
END_VAR
VAR
    _w0             : WORD;
    _w1             : WORD;
    _dword          : DWORD;
    _result         : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_w0 := swapBytes(inpWord0);
_w1 := swapBytes(inpWord1);
_dword := combineWords(_w0, _w1);
MEMCPY(ADR(_result), ADR(_dword), SIZEOF(REAL));
wordsToReal := _result;
]]></ST>
      </Implementation>
    </Method>
