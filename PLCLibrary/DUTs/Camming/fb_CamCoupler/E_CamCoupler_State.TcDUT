<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_CamCoupler_State" Id="{29bc904a-31c6-4577-8c1a-884a0b911436}">
    <Declaration><![CDATA[// State of the couple/decouple sequence for one slave-master pair.
// Execution order of a couple: eIdle -> eYielding -> eSelecting -> eCoupling -> eCoupled.
// Execution order of a decouple: (engaged) -> eDecoupling -> eStopping -> eIdle (or eError on fault).
TYPE E_CamCoupler_State :
(
    eIdle       := 0,  // not coupled, waiting for a couple request
    eSelecting  := 1,  // MC_CamTableSelect running (register the verified table)
    eYielding   := 2,  // fb_Axis yielded; waiting for the slave to reach standstill before selecting
    eCoupling   := 3,  // MC_CamIn running (RampIn engage); waiting for InSync
    eCoupled    := 4,  // synchronized to the master via the cam (steady state)
    eDecoupling := 5,  // MC_CamOut running (disengage)
    eStopping   := 6,  // MC_Halt running to kill the retained slave velocity, then release the yield
    eError      := 7   // latched coupler error; requires cmdReset/inpReset
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
