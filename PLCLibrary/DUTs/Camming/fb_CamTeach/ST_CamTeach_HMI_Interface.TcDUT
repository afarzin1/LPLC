<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_CamTeach_HMI_Interface" Id="{eae9b0ec-bf15-4b42-b038-a64e0f0ea230}">
    <Declaration><![CDATA[// Full HMI interface for one fb_CamTeach instance - the struct an HMI binds.
// Same nested Status / Commands / Config convention as ST_Axis_HMI_Interface, but with
// NO HMIbaseDevice: fb_CamTeach is a standalone library primitive and does NOT extend
// abs_fb_Device, so it carries its own error model (Status.stsError / stsErrorText).
TYPE ST_CamTeach_HMI_Interface :
STRUCT
    Status   : ST_CamTeach_HMI_Status;
    Commands : ST_CamTeach_HMI_Commands;
    Config   : ST_CamTeach_HMI_Config;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
