<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_BannerWLS15Pro_Intensity" Id="{bc773d3f-4049-4be1-abd5-965c0f2338bf}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
// Run Mode Color 1 / Color 2 Intensity, subindices 3 and 7 (219132 Rev. A,
// section 1.3.2). eCustom uses the device's custom intensity parameter.
TYPE E_BannerWLS15Pro_Intensity :
(
    eHigh   := 0,
    eLow    := 1,
    eMedium := 2,
    eOff    := 3,
    eCustom := 4
) BYTE;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
