<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_BannerWLS15Pro_Speed" Id="{828049b9-039a-4dc5-a6b1-c95fb4f55df6}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
// Run Mode animation speed, subindex 4 (219132 Rev. A, section 1.3.2).
// eCustomFlashRate uses the device's custom flash rate parameter.
TYPE E_BannerWLS15Pro_Speed :
(
    eMedium          := 0,
    eFast            := 1,
    eSlow            := 2,
    eCustomFlashRate := 3
) BYTE;
END_TYPE
]]></Declaration>
  </DUT>
