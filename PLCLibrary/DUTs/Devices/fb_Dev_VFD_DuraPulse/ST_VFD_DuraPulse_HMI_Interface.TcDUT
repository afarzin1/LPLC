<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_VFD_DuraPulse_HMI_Interface" Id="{a2b00003-0000-4000-8000-000000000001}">
    <Declaration><![CDATA[TYPE ST_VFD_DuraPulse_HMI_Interface :
STRUCT
	HMIbaseDevice		: ST_Device_HMI_Interface;
	stsInterlocks		: ST_Interlock_HMI_Interface;

	// Operator commands
	ocmdReset			: BOOL;
	ocmdRunMode			: USINT;	// 0=stop, 1=fwd, 2=reverse
	ocmdSetpoint		: LREAL;	// absolute Hz, 0..cfgMaxFreqHz

	// Command echo
	stsRunMode			: USINT;
	stsSetpoint			: LREAL;

	// Drive state
	stsState			: STRING;
	stsRunning			: BOOL;
	stsRemote			: BOOL;
	stsTripped			: BOOL;
	stsAlarm			: BOOL;
	stsDirection		: INT;		// 1=fwd, -1=rev, 0=stopped

	// Telemetry (engineering units)
	stsOutputFreq		: LREAL;	// Hz, signed
	stsMotorRPM			: LREAL;	// rpm, signed
	stsMotorCurrent		: LREAL;	// A
	stsDCBusVoltage		: LREAL;	// VDC
	stsOutputVoltage	: LREAL;	// VAC
	stsMotorTorque		: LREAL;	// %
	stsInverterTemp		: LREAL;	// degC
	stsFaultCode		: USINT;
	stsFaultText		: STRING;
	stsWarningCode		: USINT;
	stsWarningText		: STRING;

	// Diagnostics
	stsCWRaw			: WORD;
	stsSWRaw			: WORD;
	stsCommsConnected	: BOOL;
	stsCommsFaulted		: BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
