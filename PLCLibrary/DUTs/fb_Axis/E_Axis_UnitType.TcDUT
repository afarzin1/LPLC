<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_Axis_UnitType" Id="{b2c3d4e5-f6a7-8901-bc02-ef2345678901}">
    <Declaration><![CDATA[// Axis kinematic type - drives HMI unit display. NC has no unit metadata, so
// fb_Axis carries this; the actual unit label is configured separately (cfgUnit).
TYPE E_Axis_UnitType :
(
    eLinear := 0,  // translational axis - position e.g. mm, m
    eRotary := 1   // rotational axis  - position e.g. deg, rev
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
