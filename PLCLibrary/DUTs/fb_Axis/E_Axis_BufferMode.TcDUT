<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_Axis_BufferMode" Id="{b2c3d4e5-f6a7-8901-bc12-f12345678901}">
    <Declaration><![CDATA[TYPE E_Axis_BufferMode :
(
    eAborting     := 0,  // Phase 1 - abort current move, start next immediately
    eBuffered     := 1,  // reserved Phase 2
    eBlendingLow  := 2,  // reserved Phase 2
    eBlendingHigh := 3,  // reserved Phase 2
    eBlendingNext := 4,  // reserved Phase 2
    eBlendingPrev := 5   // reserved Phase 2
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
